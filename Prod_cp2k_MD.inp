&GLOBAL
  ! the project name is made part of most output files... useful to keep order
  PROJECT AIMD_LATP_prod_1
  ! various runtypes (energy, geo_opt, etc.) available.
  RUN_TYPE MD             
  ! reduce the amount of IO
  IOLEVEL  LOW 
&END GLOBAL

&EXT_RESTART
    RESTART_FILE_NAME AIMD_LATP_eq-1.restart
    RESTART_DEFAULT F
    RESTART_CELL T
    RESTART_POS T
    RESTART_VEL T
&END EXT_RESTART

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    WFN_RESTART_FILE_NAME AIMD_LATP_eq-RESTART.wfn
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF     400
      REL_CUTOFF 50
      NGRIDS     4
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      METHOD GPW
    &END QS
    &SCF
      SCF_GUESS RESTART  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
      EPS_SCF 1.0E-6
      MAX_SCF 3000
      &OT
        MINIMIZER      CG
        PRECONDITIONER FULL_ALL
	ENERGY_GAP 1.0E-3
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL 
	&PBE
	  PARAMETRIZATION ORIG
	&END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL  PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE                 DFTD3
          PARAMETER_FILE_NAME  dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END
    &END XC
  &END DFT
  &SUBSYS
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Li
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
   ENSEMBLE NVT
   TEMPERATURE [K] 1000
   TIMESTEP [fs] 2
   STEPS 50000
   COMVEL_TOL 0.0
   &THERMOSTAT
     TYPE CSVR
     &CSVR
	TIMECON [fs] 1000
     &END CSVR
   &END THERMOSTAT
    &PRINT
      &PROGRAM_RUN_INFO
        &EACH
          MD 100
        &END
      &END
      &ENERGY
        &EACH
          MD 100
        &END
      &END
    &END
  &END MD

  &PRINT
   &TRAJECTORY
     &EACH
       MD 50
     &END EACH
   &END TRAJECTORY
   &VELOCITIES OFF
   &END VELOCITIES
   &FORCES ON
      FILENAME forces
      FORMAT XYZ
   &END FORCES
   &RESTART_HISTORY
     &EACH
       MD 1000
     &END EACH
   &END RESTART_HISTORY
   &RESTART
     BACKUP_COPIES 3
     &EACH
       MD 1000
     &END EACH
   &END RESTART
  &END PRINT
&END
