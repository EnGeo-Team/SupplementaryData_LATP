&GLOBAL
  PROJECT Batch_reftraj
  PRINT_LEVEL LOW
  RUN_TYPE MD
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    MULTIPLICITY 1
    CHARGE -47

    WFN_RESTART_FILE_NAME ./Batch_reftraj-RESTART.wfn
    &MGRID
      CUTOFF     400
      REL_CUTOFF 50
      NGRIDS     4
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      METHOD GPW
    &END QS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-6
      MAX_SCF 3000
      IGNORE_CONVERGENCE_FAILURE
      &OT
        MINIMIZER      CG
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 1.0E-3
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
        &PBE
          PARAMETRIZATION ORIG
        &END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL  PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE                 DFTD3
          PARAMETER_FILE_NAME  /software/sse/manual/CP2K/2023.1-gcc-11.3.0-bare/nsc1/data/dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      CELL_FILE_FORMAT CIF
      CELL_FILE_NAME ../structure.cif
    &END CELL

    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME trajectory.xyz
    &END TOPOLOGY
    &KIND Ag
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Al
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND As
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Au
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Ba
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Be
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Bi
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Br
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND C
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Ca
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Cd
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Cl
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Co
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Cr
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Cs
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Cu
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND F
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Fe
       BASIS_SET DZVP-MOLOPT-SR-GTH
