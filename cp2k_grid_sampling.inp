       POTENTIAL GTH-PBE
    &END KIND
    &KIND Rh
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND S
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Sb
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Sc
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Se
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Si
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Sn
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Sr
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Te
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Ti
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Tl
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND V
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND W
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Y
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Zn
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND
    &KIND Zr
       BASIS_SET DZVP-MOLOPT-SR-GTH
       POTENTIAL GTH-PBE
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE REFTRAJ
    &REFTRAJ
      TRAJ_FILE_NAME trajectory.xyz
      STRIDE 1
      LAST_SNAPSHOT 100
      EVAL ENERGY_FORCES
    &END REFTRAJ
    &PRINT
      &ENERGY
        &EACH
          MD 1
        &END
      &END
    &END
  &END MD
  &PRINT
    &FORCES ON
      FILENAME forces
      FORMAT XYZ
    &END FORCES
  &END PRINT
&END MOTION

